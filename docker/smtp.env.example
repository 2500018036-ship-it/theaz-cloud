# Copy to the root-owned production stack .env (mode 0600), never to Git.
email_protocol=smtp
email_SMTPHost=smtp.gmail.com
email_SMTPPort=587
email_SMTPCrypto=tls
email_SMTPUser=
email_SMTPPass=
email_SMTPTimeout=15
email_fromEmail=
email_fromName="Theaz Cloud"
auth_emailVerificationDeferred=false
