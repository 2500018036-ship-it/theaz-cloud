# Copy this file to .env for non-Docker local development.
# Do not commit real credentials.

CI_ENVIRONMENT = development

app_baseURL = http://localhost:8080/
app_appTimezone = Asia/Jakarta
app_forceGlobalSecureRequests = false
cookie_secure = false
cookie_samesite = Lax

database_default_hostname = localhost
database_default_database = storage_cloud
database_default_username = storage_cloud
# database_default_password = set-this-locally
database_default_DBDriver = MySQLi
database_default_port = 3306

clouddrive_storagePath = writable/cloud-drive
clouddrive_maxUploadSizeBytes = 128849018880
clouddrive_chunkSizeBytes = 16777216
clouddrive_pageSize = 24
clouddrive_maxPageSize = 100
clouddrive_tempFileMaxAgeSeconds = 86400

logger_threshold = 9

# Initial admin bootstrap is explicit and controlled.
# Do not commit real values.
# AUTH_BOOTSTRAP_ADMIN_EMAIL =
# AUTH_BOOTSTRAP_ADMIN_USERNAME =
# AUTH_BOOTSTRAP_ADMIN_PASSWORD =

auth_defaultQuotaBytes = 5368709120
auth_loginMaxAttempts = 5
auth_loginDecaySeconds = 300

# Email transport for verification and queued notifications.
# Gmail SMTP example. Put the real Google App Password only in local .env,
# Docker env files, shell secrets, or your secret manager; never commit it.
# Use the email:test command to verify SMTP after secrets are configured.
# Use email:send-queued from cron/systemd timer to deliver queued mail.
email_fromEmail = muhammad.azril.achdi@gmail.com
email_fromName = Theaz Cloud
email_protocol = smtp
email_SMTPHost = smtp.gmail.com
email_SMTPPort = 587
email_SMTPUser = muhammad.azril.achdi@gmail.com
email_SMTPPass = your-google-app-password
email_SMTPCrypto = tls
email_SMTPTimeout = 10
